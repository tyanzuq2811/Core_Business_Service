# ================================================================
# Core Business Service — Environment Variables
# ================================================================

# --- Port Mapping Configuration ---
HOST_API_PORT=8001
APP_PORT=8000
APP_HOST=0.0.0.0

# --- Service Metadata & Auth ---
SERVICE_NAME=core-business
SERVICE_VERSION=0.5.0
AUTH_TOKEN=mock-core-token-2026
ENV=lan

# --- Dual Storage Toggle (PostgreSQL & In-Memory) ---
# Chuyển đổi giữa 2 kiểu lưu trữ: "postgres" (Compose DB) hoặc "memory" (RAM local)
# Mở/comment 1 trong 2 dòng dưới đây khi cần đổi nhanh:
STORAGE_BACKEND=postgres
# STORAGE_BACKEND=memory
STORAGE_FALLBACK_MEMORY=false

# --- PostgreSQL Configuration ---
POSTGRES_USER=lab05
POSTGRES_PASSWORD=lab05pass
POSTGRES_DB=coredb

# --- Core Business Rules ---
TEMP_HIGH_THRESHOLD=40.0
TEMP_CRITICAL_THRESHOLD=50.0
ACCESS_RATE_LIMIT_MAX=10
ENFORCE_TIME_WINDOW=true
BLACKLISTED_CARDS=RFID-2026-999

# ================================================================
# ĐỊA CHỈ CÁC SERVICE ĐỐI TÁC (Mạng LAN Plug-a-thon)
# Nếu chạy giả lập Compose Mock local: dùng docker-compose.mock.yml
# ================================================================

# 1. IoT Ingestion
IOT_SERVICE_URL=http://192.168.1.11:8000

# 2. Access Gate
GATE_SERVICE_URL=http://192.168.1.31:8000
GATE_AUTH_TOKEN=dev-secret-token

# 3. AI Vision
AI_VISION_URL=http://192.168.1.41:8000
AI_VISION_AUTH_TOKEN=local-dev-token-vision

# 4. Analytics (REST + MQTT Broker)
ANALYTICS_SERVICE_URL=http://192.168.1.51:8000
MQTT_BROKER_HOST=192.168.1.51
MQTT_BROKER_PORT=1883
MQTT_TOPIC_BUSINESS_EVENTS=business.events

# 5. Notification
NOTIFICATION_SERVICE_URL=http://192.168.1.61:8000
ALERT_RECIPIENT=security-ops@campus.local
