# ================================================================
# Core Business Service — Environment Variables (LAN Mode)
# ================================================================

# --- Port Mapping Configuration ---
HOST_API_PORT=8001
APP_PORT=8000
APP_HOST=0.0.0.0

# --- Service Metadata ---
SERVICE_NAME=core-business
SERVICE_VERSION=0.5.0
AUTH_TOKEN=mock-core-token-2026
ENV=lan

# --- Database Configuration ---
POSTGRES_USER=lab05
POSTGRES_PASSWORD=lab05pass
POSTGRES_DB=coredb

# ================================================================
# ĐỊA CHỈ IP / URL CỦA CÁC NHÓM TRONG MẠNG LAN (Plug-a-thon)
# Cập nhật địa chỉ IP thật của máy bạn bè trong cùng mạng Wi-Fi
# ================================================================

# 1. Nhóm IoT Ingestion (Nhóm 1)
IOT_SERVICE_URL=http://192.168.1.11:8000

# 2. Nhóm Access Gate (Nhóm 3)
GATE_SERVICE_URL=http://192.168.1.31:8000
